{
  "name": "@ste-memory/st-extension",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "sync": "node --experimental-strip-types scripts/sync.ts",
    "deploy:st": "npm run build && npm run sync",
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.0.0",
    "typebox": "^1.3.10",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@ste-memory/core": "workspace:*",
    "@ste-memory/memory-host-shared": "workspace:*",
    "dexie": "^4.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
