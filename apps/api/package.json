{
  "name": "@ste-memory/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/main.ts",
    "migrate": "node --env-file-if-exists=.env --experimental-strip-types src/migrate.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@ste-memory/core-sqlite": "workspace:*",
    "fastify": "^5.0.0"
  }
}
