{
  "name": "@ste-memory/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "cd ../.. && node --env-file-if-exists=.env --watch --experimental-strip-types apps/api/src/main.ts",
    "migrate": "cd ../.. && node --env-file-if-exists=.env --experimental-strip-types apps/api/src/migrate.ts",
    "start": "cd ../.. && node --env-file-if-exists=.env --experimental-strip-types apps/api/dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@ste-memory/application": "*",
    "@ste-memory/core-sqlite": "*",
    "@ste-memory/sqlite-utils": "*",
    "fastify": "^5.0.0"
  }
}
