    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.9.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
