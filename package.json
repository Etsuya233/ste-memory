{
  "name": "ste-memory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "web:dev": "concurrently --kill-others --names api,web \"pnpm --filter @ste-memory/api dev\" \"pnpm --filter @ste-memory/web dev\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "web:migrate": "pnpm --filter @ste-memory/api migrate",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@ste-memory/shared-config": "workspace:*",
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
